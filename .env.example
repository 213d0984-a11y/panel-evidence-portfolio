# 保存先（未指定ならプロジェクト直下の data/）
RAG_DATA_DIR=data

# 日本語を含む軽量な多言語Embeddingモデル
RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-small
RAG_MIN_RELEVANCE_SCORE=0.72
RAG_TOP_K=5
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=150

# extractive: API不要の根拠抜粋モード / openai: LLM回答モード
RAG_LLM_PROVIDER=extractive
RAG_LLM_MODEL=gpt-5.4-mini

# RAG_LLM_PROVIDER=openai のときだけ設定
OPENAI_API_KEY=

